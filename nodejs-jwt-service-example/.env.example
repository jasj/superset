# Environment variables for JWT Auth Service
# Copy this file to .env.dev or .env.prod and fill in your values

# JWT Configuration
JWT_SECRET=your-very-secure-secret-key-change-me
JWT_EXPIRATION=1h

# CORS Configuration
CORS_ORIGIN=http://localhost:8088

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (if using external database)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=auth_db
# DB_USER=auth_user
# DB_PASSWORD=your_db_password

# AWS Configuration (for Serverless Framework)
# AWS_REGION=us-east-1
# AWS_PROFILE=default
