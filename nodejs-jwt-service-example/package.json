{
  "name": "superset-jwt-auth-service",
  "version": "1.0.0",
  "description": "JWT Authentication Service for Apache Superset with Multi-Tenant Support",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "hash-password": "node server.js hash-password",
    "deploy": "serverless deploy",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "offline": "serverless offline",
    "remove": "serverless remove"
  },
  "keywords": [
    "jwt",
    "authentication",
    "superset",
    "multi-tenant",
    "serverless"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "serverless": "^4.0.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-offline": "^13.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
