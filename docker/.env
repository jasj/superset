# Allowing python to print() in docker
PYTHONUNBUFFERED=1

COMPOSE_PROJECT_NAME=superset
DEV_MODE=true

# Port configuration (override in .env-local for multiple instances)
# NGINX_PORT=80
# SUPERSET_PORT=8088
# NODE_PORT=9000
# WEBSOCKET_PORT=8080
# CYPRESS_PORT=8081
# DATABASE_PORT=5432
# REDIS_PORT=6379

# database configurations (do not modify)
DATABASE_DB=superset
DATABASE_HOST=sibubi.cluster-c5qscoiacao2.us-east-1.rds.amazonaws.com
# Make sure you set this to a unique secure random value on production
DATABASE_PASSWORD=SQLwertyuiop123
DATABASE_USER=postgres

EXAMPLES_DB=examples
EXAMPLES_HOST=db
EXAMPLES_USER=examples
# Make sure you set this to a unique secure random value on production
EXAMPLES_PASSWORD=examples
EXAMPLES_PORT=5432

# database engine specific environment variables
# change the below if you prefer another database engine
DATABASE_PORT=5432
DATABASE_DIALECT=postgresql
POSTGRES_DB=asedev2
POSTGRES_USER=postgres
# Make sure you set this to a unique secure random value on production
POSTGRES_PASSWORD=SQLwertyuiop123
#MYSQL_DATABASE=superset
#MYSQL_USER=superset
#MYSQL_PASSWORD=superset
#MYSQL_RANDOM_ROOT_PASSWORD=yes

# Add the mapped in /app/pythonpath_docker which allows devs to override stuff
PYTHONPATH=/app/pythonpath:/app/docker/pythonpath_dev
REDIS_HOST=redis
REDIS_PORT=6379

# Development and logging configuration
# FLASK_DEBUG: Enables Flask dev features (auto-reload, better error pages) - keep 'true' for development
FLASK_DEBUG=true
# SUPERSET_LOG_LEVEL: Controls Superset application logging verbosity (debug, info, warning, error, critical)
SUPERSET_LOG_LEVEL=info

SUPERSET_APP_ROOT="/"
SUPERSET_ENV=development
SUPERSET_LOAD_EXAMPLES=yes
CYPRESS_CONFIG=false
SUPERSET_PORT=8088
MAPBOX_API_KEY=''

# Make sure you set this to a unique secure random value on production
SUPERSET_SECRET_KEY=TEST_NON_DEV_SECRET
ENABLE_PLAYWRIGHT=false
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
BUILD_SUPERSET_FRONTEND_IN_DOCKER=true

# ==============================================================================
# JWT Authentication Configuration
# ==============================================================================
# URL of your Node.js authentication service
# Use host.docker.internal to access services running on the host machine
JWT_LOGIN_SERVICE_URL=http://host.docker.internal:3000/api/auth/login

# JWT Secret Key - MUST match your Node.js service
# Change this to a secure random value in production
JWT_SECRET_KEY=your-secret-key-here

# JWT Algorithm
JWT_ALGORITHM=HS256

# JWT Verification (true/false)
JWT_VERIFY=true

# Sync roles from JWT claims (true/false)
# Set to true to use roles from JWT token (recommended)
JWT_SYNC_ROLES=true

# Default role for new users (Alpha, Gamma, Public)
# Alpha: Can create/edit dashboards and charts
# Gamma: Can only view assigned dashboards
# Public: Very limited access
AUTH_USER_REGISTRATION_ROLE=Alpha

# ==============================================================================
# Multi-Tenant Database Configuration
# ==============================================================================
# Enable multi-tenant database routing
# When enabled, each tenant connects to a separate database
MULTI_TENANT_ENABLED=true

# Database name template for tenants
# Available placeholders: {tenant}
# Example: "{tenant}_db" creates databases like "acme_db", "demo_db"
# Default: "{tenant}" creates databases matching the tenant name exactly
TENANT_DATABASE_TEMPLATE={tenant}
